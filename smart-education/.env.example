# This is a static HTML app. Browser configuration lives in
# assets/js/core/config.js and may contain only public values.
# Never put service-role, SMS, Gemini, CLI, or other private keys here.

# Server-only values belong in Supabase Edge Function secrets:
# SUPABASE_SERVICE_ROLE_KEY=
# FAST2SMS_API_KEY=
# GEMINI_API_KEY=